@page
@model PortfolioBackend.Pages.Admin.CertificatesModel
@{
    ViewData["Title"] = "Sertifika Yönetimi";
    Layout = "_AdminLayout";
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Sertifikalar</h4>
                <p class="card-description">
                    Mevcut sertifikalarınızı buradan yönetebilirsiniz.
                </p>

                <button type="button" class="btn btn-primary mb-3" data-toggle="modal" data-target="#certificateModal" id="btnAddNew">
                    Yeni Sertifika Ekle
                </button>

                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Sertifika Başlığı</th>
                                <th>Başlangıç Tarihi</th>
                                <th>Bitiş Tarihi</th>
                                <th>Link</th>
                                <th>Eylemler</th>
                            </tr>
                        </thead>
                        <tbody id="certificateTableBody">
                            <tr>
                                <td colspan="5" class="text-center">Yükleniyor...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="certificateModal" tabindex="-1" role="dialog" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Sertifika Yönetimi</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <form id="certificateForm">
                    <input type="hidden" id="certificateId">

                    <div class="form-group">
                        <label for="certificateTitle">Sertifika Başlığı</label>
                        <input type="text" class="form-control" id="certificateTitle" placeholder="örn: .NET Core">
                    </div>

                    <div class="form-group">
                        <label for="certificateDescription">Açıklama</label>
                        <textarea class="form-control" id="certificateDescription" rows="4"></textarea>
                    </div>

                    <div class="form-group">
                        <label for="certificateLink">Sertifika Linki</label>
                        <input type="url" class="form-control" id="certificateLink" placeholder="https://...">
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="certificateStartDate">Başlangıç Tarihi</label>
                                <input type="date" class="form-control" id="certificateStartDate">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="certificateEndDate">Bitiş Tarihi (Opsiyonel)</label>
                                <input type="date" class="form-control" id="certificateEndDate">
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" id="btnSaveCertificate">Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL_CERTIFICATES = "/api/certificates";
        const tableBody = document.getElementById("certificateTableBody");
        const modal = $('#certificateModal'); // Modalı jQuery ile seçiyoruz
        const modalTitle = document.getElementById("modalTitle");

        // !! GÜNCELLEME: API Anahtarınızı buraya girin
        const MY_API_KEY = "hasret9050!";

        // !! GÜNCELLEME: API'nizin beklediği başlık adı
        const API_KEY_HEADER = "X-API-Key";
        // Veya "Authorization" (eğer "Bearer <key>" ise değeri "Bearer " + MY_API_KEY yapın)


        // --- 1. LİSTELEME (GET) ---
        // Bu fonksiyonda değişiklik yok, GET işlemi key istemiyor.
        document.addEventListener('DOMContentLoaded', () => {
            loadCertificates();
        });

        async function loadCertificates() {
            try {
                const response = await fetch(API_URL_CERTIFICATES);
                const certificates = await response.json();

                tableBody.innerHTML = ''; // Tabloyu temizle

                if (certificates.length === 0) {
                     tableBody.innerHTML = '<tr><td colspan="5" class="text-center">Kayıt bulunamadı.</td></tr>';
                     return;
                }

                certificates.forEach(cert => {
                    const startDate = new Date(cert.startDate).toLocaleDateString('tr-TR');
                    const endDate = cert.endDate
                                  ? new Date(cert.endDate).toLocaleDateString('tr-TR')
                                  : '<span class="badge badge-info">Opsiyonel</span>';

                    const row = `
                        <tr>
                            <td>${cert.title}</td>
                            <td>${startDate}</td>
                            <td>${endDate}</td>
                            <td><a href="${cert.link}" target="_blank">Link</a></td>
                            <td>
                                <button class="btn btn-warning btn-sm btn-edit" data-id="${cert.id}">Düzenle</button>
                                <button class="btn btn-danger btn-sm btn-delete" data-id="${cert.id}">Sil</button>
                            </td>
                        </tr>
                    `;
                    tableBody.innerHTML += row;
                });
            } catch (error) {
                console.error('Hata:', error);
                tableBody.innerHTML = `<tr><td colspan="5" class="text-center text-danger">Veriler yüklenemedi.</td></tr>`;
            }
        }

        // --- 2. YENİ EKLEME (CREATE) ---
        // Bu fonksiyonda değişiklik yok.
        document.getElementById("btnAddNew").addEventListener('click', () => {
            resetForm();
            modalTitle.innerText = "Yeni Sertifika Ekle";
        });

        // --- 3. DÜZENLEME (UPDATE) & 4. SİLME (DELETE) ---
        // !! GÜNCELLEME: İki listener tek fonksiyonda birleştirildi.
        tableBody.addEventListener('click', async (event) => {
            const targetButton = event.target.closest('button');
            if (!targetButton) return;

            // --- DÜZENLEME (GET /id) ---
            // Bu (GET) işleminde key gerekmediği için değişiklik yok.
            if (targetButton.classList.contains('btn-edit')) {
                const idToEdit = targetButton.getAttribute('data-id');
                try {
                    const response = await fetch(`${API_URL_CERTIFICATES}/${idToEdit}`);
                    if (!response.ok) throw new Error("Kayıt bulunamadı");

                    const data = await response.json();

                    document.getElementById("certificateId").value = data.id;
                    document.getElementById("certificateTitle").value = data.title;
                    document.getElementById("certificateDescription").value = data.description;
                    document.getElementById("certificateLink").value = data.link;
                    document.getElementById("certificateStartDate").value = data.startDate.split('T')[0];
                    if (data.endDate) {
                        document.getElementById("certificateEndDate").value = data.endDate.split('T')[0];
                    } else {
                        document.getElementById("certificateEndDate").value = "";
                    }

                    modalTitle.innerText = "Sertifikayı Düzenle";
                    modal.modal('show');

                } catch (error) {
                    console.error("Veri çekme hatası:", error);
                    alert("Sertifika bilgileri yüklenemedi.");
                }
            }

            // --- SİLME (DELETE) ---
            if (targetButton.classList.contains('btn-delete')) {
                const idToDelete = targetButton.getAttribute('data-id');

                if (confirm(`ID: ${idToDelete} olan kaydı silmek istediğinize emin misiniz?`)) {
                    try {
                        // !! GÜNCELLEME: fetch isteğine 'headers' eklendi
                        const response = await fetch(`${API_URL_CERTIFICATES}/${idToDelete}`, {
                            method: 'DELETE',
                            headers: {
                                [API_KEY_HEADER]: MY_API_KEY
                            }
                        });

                        if (response.ok) {
                            alert('Kayıt başarıyla silindi.');
                            loadCertificates(); // Tabloyu yenile
                        } else {
                            alert('Hata: Kayıt silinemedi. (Yetki hatası olabilir)');
                        }
                    } catch (error) {
                        console.error('Silme hatası:', error);
                        alert('Sunucuya bağlanırken bir hata oluştu.');
                    }
                }
            }
        });

        // --- 5. KAYDETME (CREATE veya UPDATE) ---
        document.getElementById("btnSaveCertificate").addEventListener("click", async () => {
            const id = document.getElementById("certificateId").value;
            const certificateData = {
                title: document.getElementById("certificateTitle").value,
                description: document.getElementById("certificateDescription").value,
                link: document.getElementById("certificateLink").value,
                startDate: document.getElementById("certificateStartDate").value,
                endDate: document.getElementById("certificateEndDate").value || null
            };

            let httpMethod = 'POST';
            let fullUrl = API_URL_CERTIFICATES;

            if (id) {
                httpMethod = 'PUT';
                fullUrl = `${API_URL_CERTIFICATES}/${id}`;
                certificateData.id = parseInt(id);
            }

            try {
                // !! GÜNCELLEME: fetch isteğine 'headers' eklendi
                const response = await fetch(fullUrl, {
                    method: httpMethod,
                    headers: {
                        'Content-Type': 'application/json',
                        [API_KEY_HEADER]: MY_API_KEY
                    },
                    body: JSON.stringify(certificateData)
                });

                if (response.ok) {
                    alert('İşlem başarılı!');
                    modal.modal('hide');
                    loadCertificates();
                } else {
                    const errorData = await response.json();
                    alert('Hata oluştu: ' + JSON.stringify(errorData.errors || errorData));
                }
            } catch (error) {
                console.error('Kaydetme hatası:', error);
                alert('Sunucuya bağlanırken bir hata oluştu.');
            }
        });

        // --- Form Temizleme ---
        // Bu fonksiyonda değişiklik yok.
        function resetForm() {
            document.getElementById("certificateForm").reset();
            document.getElementById("certificateId").value = "";
        }

    </script>
}