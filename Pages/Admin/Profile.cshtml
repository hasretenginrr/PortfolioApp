@page
@model PortfolioBackend.Pages.Admin.ProfileModel
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    Layout = "_AdminLayout";
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Kullanıcılar</h4>
                <p class="card-description">
                    Sistemdeki kullanıcıları yönetin.
                </p>

                <button type="button" class="btn btn-primary mb-3" data-toggle="modal" data-target="#userModal" id="btnAddNew">
                    Yeni Kullanıcı Ekle
                </button>

                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Ad Soyad</th>
                                <th>Unvan</th>
                                <th>Email</th>
                                <th>Eylemler</th>
                            </tr>
                        </thead>
                        <tbody id="userTableBody">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="userModal" tabindex="-1" role="dialog" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Kullanıcı Yönetimi</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <form id="userForm">
                    <input type="hidden" id="userId">

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="userFullName">Tam Adınız</label>
                                <input type="text" class="form-control" id="userFullName" placeholder="Ad Soyad">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="userTitle">Unvanınız</label>
                                <input type="text" class="form-control" id="userTitle" placeholder="örn: .NET Developer">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="userBio">Biyografi</label>
                        <textarea class="form-control" id="userBio" rows="5" placeholder="Kendiniz hakkında kısa bir açıklama..."></textarea>
                    </div>

                    <hr>
                    <h5 class="card-title mt-2">İletişim & Linkler</h5>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="userEmail">Email Adresi</label>
                                <input type="email" class="form-control" id="userEmail" placeholder="iletisim@mail.com">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="userPhone">Telefon</label>
                                <input type="tel" class="form-control" id="userPhone" placeholder="+90 555...">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="userProfileImageUrl">Profil Fotoğrafı URL'si</label>
                        <input type="url" class="form-control" id="userProfileImageUrl" placeholder="https://...">
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="userGitHub">GitHub Linki</label>
                                <input type="url" class="form-control" id="userGitHub" placeholder="https://github.com/kullaniciadi">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="userLinkedIn">LinkedIn Linki</label>
                                <input type="url" class="form-control" id="userLinkedIn" placeholder="https://linkedin.com/in/kullaniciadi">
                            </div>
                        </div>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" id="btnSaveUser">Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL_USERS = "/api/users";
        const tableBody = document.getElementById("userTableBody");
        const modal = $('#userModal');
        const modalTitle = document.getElementById("modalTitle");

        // API Anahtarınız
        const MY_API_KEY = "hasret9050!";

        // API'nizin beklediği başlık adı
        const API_KEY_HEADER = "X-API-Key";

        // --- 1. LİSTELEME (GET) ---
        document.addEventListener('DOMContentLoaded', () => {
            loadUsers();
        });

        async function loadUsers() {
            try {
                const response = await fetch(API_URL_USERS); // GET'te key yok
                const users = await response.json();

                tableBody.innerHTML = '';
                if (users.length === 0) {
                     tableBody.innerHTML = '<tr><td colspan="4" class="text-center">Kayıt bulunamadı.</td></tr>';
                     return;
                }
                users.forEach(user => {
                    const row = `
                        <tr>
                            <td>${user.fullName}</td>
                            <td>${user.title}</td>
                            <td>${user.email}</td>
                            <td>
                                <button class="btn btn-warning btn-sm btn-edit" data-id="${user.id}">Düzenle</button>
                                <button class="btn btn-danger btn-sm btn-delete" data-id="${user.id}">Sil</button>
                            </td>
                        </tr>
                    `;
                    tableBody.innerHTML += row;
                });
            } catch (error) {
                console.error('Hata:', error);
                tableBody.innerHTML = `<tr><td colspan="4" class="text-center text-danger">Veriler yüklenemedi.</td></tr>`;
            }
        }

        // --- 2. YENİ EKLEME (CREATE) ---
        document.getElementById("btnAddNew").addEventListener('click', () => {
            resetForm();
            modalTitle.innerText = "Yeni Kullanıcı Ekle";
        });


        // --- 3. DÜZENLEME (UPDATE) & 4. SİLME (DELETE) ---
        tableBody.addEventListener('click', async (event) => {
            const targetButton = event.target.closest('button');
            if (!targetButton) return;

            // --- DÜZENLEME (GET /id) ---
            if (targetButton.classList.contains('btn-edit')) {
                const idToEdit = targetButton.getAttribute('data-id');
                try {
                    // Bu GET işlemi, key gerekmiyor
                    const response = await fetch(`${API_URL_USERS}/${idToEdit}`);
                    if (!response.ok) throw new Error("Kayıt bulunamadı");

                    const data = await response.json();

                    document.getElementById("userId").value = data.id;
                    document.getElementById("userFullName").value = data.fullName;
                    document.getElementById("userTitle").value = data.title;
                    document.getElementById("userBio").value = data.bio;
                    document.getElementById("userEmail").value = data.email;
                    document.getElementById("userPhone").value = data.phone;
                    document.getElementById("userProfileImageUrl").value = data.profileImageUrl;
                    document.getElementById("userGitHub").value = data.gitHub;
                    document.getElementById("userLinkedIn").value = data.linkedIn;

                    modalTitle.innerText = "Kullanıcıyı Düzenle";
                    modal.modal('show');
                } catch (error) {
                     console.error("Veri çekme hatası:", error);
                     alert("Kullanıcı bilgisi yüklenemedi.");
                }
            }

            // --- SİLME (DELETE) ---
            if (targetButton.classList.contains('btn-delete')) {
                const idToDelete = targetButton.getAttribute('data-id');

                if (confirm(`ID: ${idToDelete} olan kullanıcıyı silmek istediğinize emin misiniz?`)) {
                    try {
                        const response = await fetch(`${API_URL_USERS}/${idToDelete}`, {
                            method: 'DELETE',
                            headers: {
                                [API_KEY_HEADER]: MY_API_KEY
                            }
                        });

                        if (response.ok) {
                            alert('Kayıt başarıyla silindi.');
                            loadUsers();
                        } else {
                            alert('Hata: Kayıt silinemedi. (Yetki hatası olabilir)');
                        }
                    } catch (error) {
                        console.error('Silme hatası:', error);
                        alert('Sunucuya bağlanırken bir hata oluştu.');
                    }
                }
            }
        });

        // --- 5. KAYDETME (CREATE veya UPDATE) ---
        document.getElementById("btnSaveUser").addEventListener("click", async () => {
            const id = document.getElementById("userId").value;
            const userData = {
                fullName: document.getElementById("userFullName").value,
                title: document.getElementById("userTitle").value,
                bio: document.getElementById("userBio").value,
                email: document.getElementById("userEmail").value,
                phone: document.getElementById("userPhone").value,
                profileImageUrl: document.getElementById("userProfileImageUrl").value,
                gitHub: document.getElementById("userGitHub").value,
                linkedIn: document.getElementById("userLinkedIn").value
            };

            let httpMethod = 'POST';
            let fullUrl = API_URL_USERS;

            if (id) {
                httpMethod = 'PUT';
                fullUrl = `${API_URL_USERS}/${id}`;
                userData.id = parseInt(id);
            }

            try {
                const response = await fetch(fullUrl, {
                    method: httpMethod,
                    headers: {
                        'Content-Type': 'application/json',
                        [API_KEY_HEADER]: MY_API_KEY
                    },
                    body: JSON.stringify(userData)
                });

                if (response.ok) {
                    alert('İşlem başarılı!');
                    modal.modal('hide');
                    loadUsers();
                } else {
                    const errorData = await response.json();
                    alert('Hata oluştu: ' + JSON.stringify(errorData.errors || errorData));
                }
            } catch (error) {
                console.error('Kaydetme hatası:', error);
                alert('Sunucuya bağlanırken bir hata oluştu.');
            }
        });

        // Formu temizleyen yardımcı fonksiyon
        function resetForm() {
            document.getElementById("userForm").reset();
            document.getElementById("userId").value = "";
        }

    </script>
}